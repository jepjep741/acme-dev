# podman/.env  -  EI SALAISUUKSIA. Salaisuudet: scripts/secrets.sh (podman secret).
# Kopioi: cp .env.example .env ja täytä <...>-arvot.

# --- Imaget: kiinnitetty digestillä (päivitys: docs/paivitys-ilmarako.md) ---
NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged@sha256:bfcf1250dae73fb5dafe18b9fa64d033441510c5a2fc7a11cf8003087890301b
VAULT_IMAGE=docker.io/hashicorp/vault@sha256:8af37ae9d45e4a0fac48ab700e0d99efc4c2d6cd84354a869f2147f1d3abab46
# Oma image: import-release.sh kirjoittaa tähän ladatun imagen digestin.
LEGO_IMAGE=localhost/acme-lego:5.5.2-1

# --- Paikalliset asetukset ---
# Hakemisto, jossa certs.conf ja tls/{ca.pem,vault.crt} (oletus ./config)
ACME_CONF_DIR=./config
# nginx: palomuuri tekee DNAT 80 -> 8080
NGINX_PUBLISH=8080
# Vault julkaistaan VAIN sisäverkon IP:hen
VAULT_BIND_IP=<10.x.x.x>
VAULT_PUBLISH_PORT=8200
VAULT_API_ADDR=https://<vault.asiakas.fi>:8200

# --- ACME (DVV) ---
LEGO_SERVER=https://<DVV:n ACME directory -URL>
LEGO_EMAIL=<varmenteet@asiakas.fi>
KEY_TYPE=RSA2048          # tarkista DVV:n tukemat: RSA2048 / RSA4096 / EC256
RENEW_DAYS=30             # 0 = legon dynaaminen (1/3 voimassaolosta)
PFX_COMPAT=modern         # "legacy" jos IIS-palvelimissa on Windows Server 2016

# --- Välityspalvelin (valinnainen, vain lego-kontille) ---
HTTPS_PROXY=
NO_PROXY=
