# ~acmesvc/.config/systemd/user/vault-audit-rotate.service
# Vaultin audit-lokin kierto kontin sisällä + SIGHUP (Vault avaa lokin uudelleen).
[Unit]
Description=Vaultin audit-lokin kierto
After=acme-stack.service

[Service]
Type=oneshot
Environment=ACME_ENV=/etc/acme-podman/.env
ExecStart=/opt/acme/current/podman/scripts/vault-audit-rotate.sh
