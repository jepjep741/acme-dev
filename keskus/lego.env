# /etc/acme/lego.env   (root:acme 0640)
LEGO_SERVER=https://<DVV:n ACME directory -URL>
LEGO_EMAIL=varmenteet@asiakas.fi
LEGO_PATH=/var/lib/lego
KEY_TYPE=rsa2048                 # tarkista DVV:n tukemat avaintyypit (rsa2048/rsa4096/ec256)
RENEW_DAYS=30
PFX_COMPAT=modern               # "legacy" jos IIS-palvelimissa on Windows Server 2016 tai vanhempi

# EAB tarvitaan VAIN ensimmäisellä ajolla ACME-tilin rekisteröintiin.
# Kun tili on luotu (/var/lib/lego/accounts/...), poista nämä kaksi riviä.
LEGO_EAB_KID=
LEGO_EAB_HMAC=
