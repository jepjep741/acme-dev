# /etc/acme/vault.env   (root:acme 0640)
# Keskuspalvelimen oma Vault-yhteys lego-hookille.
# Token luodaan ylläpitäjänä:
#   vault token create -policy=acme-writer -period=768h -orphan -display-name=acme-keskus
# acme-renew.sh uusii tokenin jokaisella ajolla, joten se pysyy voimassa.
VAULT_ADDR=https://vault.asiakas.fi:8200
VAULT_CACERT=/etc/acme/vault-ca.pem
VAULT_TOKEN=
