  {
   "id": "el519779047",
   "type": "text",
   "x": 40,
   "y": 995,
   "width": 1240.8000000000002,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2132480061,
   "version": 1,
   "versionNonce": 346094056,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kulku:\n① lego (systemd-timer) tilaa / uusii varmenteen DVV:ltä   ② lego kirjoittaa haastetokenin webroot-hakemistoon\n③ DVV hakee tokenin domainin julkisesta osoitteesta portista 80   ④ Palomuuri ohjaa :80-liikenteen keskukselle,\n    joka vastaa tokenilla (muu :80-liikenne → 301 https)   ⑤ DVV myöntää varmenteen   ⑥ lego-hook tallentaa Vaultiin PEM-bundlen ja PFX:n\n⑦ Palvelimen Vault Agent (vähäoikeuksinen) hakee omat varmenteensa staging-hakemistoon: Linux PEM-bundle, Windows valmis PFX\n⑧ Root/SYSTEM-asennus vain tarkistusten jälkeen: avain vastaa, ketju DVV:n CA:han, voimassaolo, ei vanhempi kuin nykyinen\nYhteydet: palvelimet → Vault TCP 8200 (TLS, vain ulospäin) · keskus → DVV HTTPS 443 · keskus → Vault 8200 · internet → palomuuri :80 → keskus",
   "originalText": "Kulku:\n① lego (systemd-timer) tilaa / uusii varmenteen DVV:ltä   ② lego kirjoittaa haastetokenin webroot-hakemistoon\n③ DVV hakee tokenin domainin julkisesta osoitteesta portista 80   ④ Palomuuri ohjaa :80-liikenteen keskukselle,\n    joka vastaa tokenilla (muu :80-liikenne → 301 https)   ⑤ DVV myöntää varmenteen   ⑥ lego-hook tallentaa Vaultiin PEM-bundlen ja PFX:n\n⑦ Palvelimen Vault Agent (vähäoikeuksinen) hakee omat varmenteensa staging-hakemistoon: Linux PEM-bundle, Windows valmis PFX\n⑧ Root/SYSTEM-asennus vain tarkistusten jälkeen: avain vastaa, ketju DVV:n CA:han, voimassaolo, ei vanhempi kuin nykyinen\nYhteydet: palvelimet → Vault TCP 8200 (TLS, vain ulospäin) · keskus → DVV HTTPS 443 · keskus → Vault 8200 · internet → palomuuri :80 → keskus",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
